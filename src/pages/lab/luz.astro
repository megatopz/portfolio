---
import eu from '../../assets/photos/eu.jpg';
import HeroLight from '../../components/HeroLight.astro';
import { LIGHT_DEFAULTS } from '../../gl/light/light-params';
import Base from '../../layouts/Base.astro';
---

<Base title="Lab · Luz" description="Protótipo do efeito de luz" noindex surface="ink">
  <section class="lab" data-light-lab>
    <p class="label">Lab · Luz</p>
    {/* The hero spans the .lab content box: 100vw minus var(--space-8) padding on each side. */}
    <HeroLight
      src={eu}
      alt="Retrato de Gonçalo Guerra a preto e branco, em contraluz."
      sizes="calc(100vw - 4rem)"
    />
    <p class="label" data-light-values>
      min {LIGHT_DEFAULTS.min} · max {LIGHT_DEFAULTS.max} · raio {LIGHT_DEFAULTS.radius}
    </p>
    <p>
      <a href="/lab/tinta-a/">Ir para tinta A</a>
    </p>
    <script is:inline>
      // Lab only: copy ?min&max&radius onto this page's hero, to try values without a rebuild. The
      // shared HeroLight has no URL code; mountHeroLight drops invalid values and writes back the ones
      // in effect when the effect starts, which are then shown below the photo. Inline so the lab adds
      // no request in front of the hero image.
      (() => {
        const hero = document.querySelector('[data-light-lab] [data-hero-light]');
        const values = document.querySelector('[data-light-lab] [data-light-values]');
        if (!hero || !values) return;
        const query = new URLSearchParams(window.location.search);
        for (const [param, key] of [
          ['min', 'lightMin'],
          ['max', 'lightMax'],
          ['radius', 'lightRadius'],
        ]) {
          const value = query.get(param);
          if (value !== null) hero.dataset[key] = value;
        }
        new MutationObserver(() => {
          const { lightMin, lightMax, lightRadius } = hero.dataset;
          values.textContent = `min ${lightMin} · max ${lightMax} · raio ${lightRadius}`;
        }).observe(hero, { attributes: true, attributeFilter: ['data-light-radius'] });
      })();
    </script>
  </section>
</Base>

<style>
  .lab {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-8);
  }
  .lab :global(.hero-light) {
    height: min(80vh, 60rem);
  }
</style>
